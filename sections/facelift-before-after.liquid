{% comment %}
  Nookly: image + text section (for templates/product.facelift-device.json).
  Two columns: a single static image on one side and a heading, text, short review cards and an optional link on the other.
  Review cards are only shown when you fill them in, so no placeholder reviews ever go live.
  Styles live in assets/facelift.css.
{% endcomment %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="facelift-ba section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="facelift-ba__grid{% if section.settings.layout == 'text_first' %} facelift-ba__grid--reverse{% endif %}">
      <div class="facelift-ba__media">
        <div class="facelift-ba__frame">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1400
              | image_tag:
                widths: '360, 535, 750, 1070, 1400',
                sizes: '(min-width: 1200px) 560px, (min-width: 750px) 45vw, 100vw',
                loading: 'lazy',
                class: 'facelift-ba__img',
                alt: section.settings.image_alt
            }}
          {%- else -%}
            <div class="facelift-ba__img facelift-ba__placeholder placeholder">
              {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="facelift-ba__content">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <h2 class="facelift-ba__heading facelift-heading-lg inline-richtext {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                {{ block.settings.heading }}
              </h2>
            {%- when 'text' -%}
              <div class="facelift-ba__text rte" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>
            {%- when 'review' -%}
              {%- if block.settings.quote != blank -%}
                <figure class="facelift-ba__review" {{ block.shopify_attributes }}>
                  <div
                    class="facelift-stars"
                    role="img"
                    aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: block.settings.rating, rating_max: 5 }}"
                    style="--facelift-rating: {{ block.settings.rating }};"
                  ></div>
                  <blockquote class="facelift-ba__quote">&ldquo;{{ block.settings.quote | escape }}&rdquo;</blockquote>
                  {%- if block.settings.author != blank -%}
                    <figcaption class="facelift-ba__author">{{ block.settings.author | escape }}</figcaption>
                  {%- endif -%}
                </figure>
              {%- endif -%}
            {%- when 'link' -%}
              {%- if block.settings.label != blank -%}
                <a
                  {% if block.settings.url != blank %}
                    href="{{ block.settings.url }}"
                  {% else %}
                    role="link" aria-disabled="true"
                  {% endif %}
                  class="facelift-ba__link link underlined-link"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.label | escape }}
                </a>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Facelift image with text",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "info": "Use italics for the serif accent, e.g. Sparse to full <em>in one press</em>",
          "default": "Sparse to full <em>in one press</em>"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Size",
          "options": [
            { "value": "h1", "label": "Large" },
            { "value": "h2", "label": "Medium" }
          ],
          "default": "h1"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Add a short line about the result.</p>"
        }
      ]
    },
    {
      "type": "review",
      "name": "Review card",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "info": "Use a real customer review only. Cards with an empty quote are hidden."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Customer name"
        }
      ]
    },
    {
      "type": "link",
      "name": "Link",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Read all reviews"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link",
          "info": "For example #reviews to jump to the reviews section."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description",
      "info": "Describe the image for screen readers. Leave empty if it is purely decorative."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop layout",
      "options": [
        { "value": "image_first", "label": "Image first" },
        { "value": "text_first", "label": "Text first" }
      ],
      "default": "image_first"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-facelift-blush"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "Facelift image with text"
    }
  ]
}
{% endschema %}
